+#if defined(PLATFORM_HOSTED) && defined(HWEMU)
+static Remote::SwitchState hwemuParseSwitch(const std::string &s, Remote::SwitchState fallback)
+{
+    if (s == "UP") return Remote::SwitchState::UP;
+    if (s == "MID") return Remote::SwitchState::MID;
+    if (s == "DOWN") return Remote::SwitchState::DOWN;
+    return fallback;
+}
+
+static Remote::SwitchState hwemuForcedSwitch(Remote::Switch which)
+{
+    static Remote::SwitchState left = Remote::SwitchState::UP, right = Remote::SwitchState::MID;
+    static bool resolved = false;
+    if (!resolved)
+    {
+        resolved = true;
+        if (const char *env = std::getenv("HWEMU_SENTRY_SWITCHES"))
+        {
+            const std::string v(env);
+            const auto comma = v.find(',');
+            left = hwemuParseSwitch(v.substr(0, comma), left);
+            if (comma != std::string::npos) right = hwemuParseSwitch(v.substr(comma + 1), right);
+        }
+        tap::hwemu::gap(
+            "sentry",
+            "remote-forced-mode",
+            "SIM HACK: no DR16 remote; sentry mode switches forced (HWEMU_SENTRY_SWITCHES, default "
+            "UP,MID = auto nav + auto aim) and the remote-disconnect safety stop is bypassed");
+    }
+    return which == Remote::Switch::LEFT_SWITCH ? left : right;
+}
+
+static Trigger hwemuSwitchState(Remote::Switch which, Remote::SwitchState state)
+{
+    return Trigger(drivers(), [which, state]() { return hwemuForcedSwitch(which) == state; });
