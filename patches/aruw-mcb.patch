+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Taproot is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with Taproot.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#if defined(PLATFORM_HOSTED) && defined(HWEMU)
+
+#include "hwemu_hal.hpp"
+
+#include <cctype>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <unistd.h>
+
+#include "modm/architecture/interface/clock.hpp"
+
+#include "hwemu_client.h"
+
+namespace tap::hwemu
+{
+namespace
+{
+std::mutex g_mutex;
+
+void gapf(const char *source, const std::string &key, const std::string &message)
+{
+    hwemu_report_gap(source, key.c_str(), message.c_str());
+}
+
+// Connects on first use; retries (at most every 100 ms) while the hub is
+// away, so a firmware started first finds it once it's up.
+template <typename Open>
+int lazyConnect(int &fd, std::chrono::steady_clock::time_point &nextTry, Open open)
+{
+    if (fd >= 0) return fd;
+    const auto now = std::chrono::steady_clock::now();
+    if (now < nextTry) return -1;
+    nextTry = now + std::chrono::milliseconds(100);
+    fd = open();
+    return fd;
+}
+
+// ---- pinbus ---------------------------------------------------------------
+int g_pinbus = -1;
+std::chrono::steady_clock::time_point g_pinbusNextTry{};
+
+int pinbus()
+{
+    const int h = lazyConnect(g_pinbus, g_pinbusNextTry, [] {
+        return hwemu_pinbus_connect(nullptr, "mcb");
+    });
+    if (h < 0)
+    {
+        gap("pinbus",
+            "no-hub",
+            "no hub pinbus yet (<runtime dir>/pinbus.sock): SPI reads 0xFF, GPIO and ADC read 0");
+    }
+    return h;
+}
+
+// ---- CAN --------------------------------------------------------------------
+int g_can[2] = {-1, -1};
+std::chrono::steady_clock::time_point g_canNextTry[2]{};
+
+int canFd(int bus)
+{
+    if (bus < 0 || bus > 1) return -1;
+    const int fd = lazyConnect(g_can[bus], g_canNextTry[bus], [bus] {
+        return hwemu_can_open(bus == 0 ? "can1" : "can2");
+    });
+    if (fd < 0)
+    {
+        gapf("can",
+             bus == 0 ? "can1:no-hub" : "can2:no-hub",
+             std::string("no hub CAN bus ") + (bus == 0 ? "can1" : "can2") +
+                 " yet; frames on it are dropped");
+    }
+    return fd;
+}
+
+// ---- UART -------------------------------------------------------------------
+constexpr const char *kPortNames[] = {"REMOTE", "USART2", "USART3", "REFSERIAL", "UART7", "UART8"};
+constexpr const char *kDefaultPorts[] = {"none", "vision_mcb", "vision_mcb", "referee", "none", "none"};
+constexpr int kPorts = 6;
+
+struct UartState
+{
+    std::string hubPort;  // empty: unconnected
+    bool initialized = false;
+};
+UartState g_uarts[kPorts];
+std::map<std::string, int> g_ptyFds;  // one fd per hub port, shared by the UARTs on it
+std::map<std::string, std::chrono::steady_clock::time_point> g_ptyNextTry;
+
+const std::string &hubPort(int port)
+{
+    static bool resolved = false;
+    if (!resolved)
+    {
+        resolved = true;
+        for (int p = 0; p < kPorts; ++p)
+        {
+            const std::string env = std::string("HWEMU_UART_") + kPortNames[p];
+            const char *value = std::getenv(env.c_str());
+            const std::string name = value != nullptr ? value : kDefaultPorts[p];
+            g_uarts[p].hubPort = name == "none" ? "" : name;
+        }
+    }
+    static const std::string empty;
+    return port >= 0 && port < kPorts ? g_uarts[port].hubPort : empty;
+}
+
+int uartFd(int port)
+{
+    const std::string &name = hubPort(port);
+    if (name.empty())
+    {
+        if (port >= 0 && port < kPorts && g_uarts[port].initialized)
+        {
+            gapf("uart",
+                 std::string("unconnected:") + kPortNames[port],
+                 std::string("UART ") + kPortNames[port] +
+                     " is used but nothing in the sim is wired to it (HWEMU_UART_" +
+                     kPortNames[port] + "); reads nothing, writes are dropped");
+        }
+        return -1;
+    }
+    auto it = g_ptyFds.find(name);
+    if (it != g_ptyFds.end() && it->second >= 0) return it->second;
+    int &fd = g_ptyFds[name];
+    if (it == g_ptyFds.end()) fd = -1;
+    lazyConnect(fd, g_ptyNextTry[name], [&name] {
+        char path[512];
+        hwemu_port_path(name.c_str(), path, sizeof(path));
+        return hwemu_serial_open(path);
+    });
+    if (fd < 0)
+    {
+        gapf("uart",
+             "no-port:" + name,
+             std::string("UART ") + kPortNames[port] + ": hub port '" + name +
+                 "' isn't there yet (<runtime dir>/" + name + "); data is dropped until it is");
+    }
+    return fd;
+}
+
+// ---- lockstep ---------------------------------------------------------------
+int g_lockstep = -2;  // -2: not decided yet; -1: not in lockstep
+uint64_t g_tick = 0;
+int g_loopsPerTick = 4;
+int g_loopsThisTick = 0;
+}  // namespace
+
+void gap(const char *source, const char *key, const char *message)
+{
+    hwemu_report_gap(source, key, message);
+}
+
+bool canSend(int bus, uint32_t id, bool extended, bool rtr, const uint8_t *data, uint8_t length)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    if (rtr)
+    {
+        gap("can", "rtr", "remote-request CAN frames aren't emulated; sent as data frames");
+    }
+    const int fd = canFd(bus);
+    return fd >= 0 && hwemu_can_send(fd, id, extended ? 1 : 0, data, length) == 0;
+}
+
+bool canReceive(int bus, uint32_t *id, bool *extended, bool *rtr, uint8_t *data, uint8_t *length)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int fd = canFd(bus);
+    if (fd < 0) return false;
+    int ext = 0;
+    const int got = hwemu_can_recv(fd, id, &ext, data, length);
+    if (got < 0)
+    {
+        // The hub went away: reconnect on a later call.
+        hwemu_can_close(fd);
+        g_can[bus] = -1;
+        return false;
+    }
+    *extended = ext != 0;
+    *rtr = false;
+    return got == 1;
+}
+
+void uartInit(int port)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    if (port < 0 || port >= kPorts) return;
+    g_uarts[port].initialized = true;
+    uartFd(port);  // connect (or report the gap) now, not at first use
+}
+
+std::size_t uartRead(int port, uint8_t *data, std::size_t length)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int fd = uartFd(port);
+    if (fd < 0) return 0;
+    const ssize_t n = ::read(fd, data, length);
+    return n > 0 ? static_cast<std::size_t>(n) : 0;
+}
+
+std::size_t uartWrite(int port, const uint8_t *data, std::size_t length)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int fd = uartFd(port);
+    if (fd < 0) return length;  // dropped, as an unconnected TX pin would; reported above
+    const ssize_t n = ::write(fd, data, length);
+    if (n < static_cast<ssize_t>(length))
+    {
+        gapf("uart",
+             std::string("overflow:") + kPortNames[port],
+             std::string("UART ") + kPortNames[port] +
+                 ": the hub's side isn't reading fast enough; bytes dropped");
+    }
+    return length;
+}
+
+std::size_t uartDiscard(int port)
+{
+    uint8_t buf[256];
+    std::size_t total = 0;
+    for (std::size_t n; (n = uartRead(port, buf, sizeof(buf))) > 0;) total += n;
+    return total;
+}
+
+void gpioWrite(const char *pin, bool level)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int h = pinbus();
+    if (h >= 0) hwemu_gpio_write(h, pin, level ? 1 : 0);
+}
+
+bool gpioRead(const char *pin)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int h = pinbus();
+    return h >= 0 && hwemu_gpio_read(h, pin) == 1;
+}
+
+uint16_t adcRead(const char *pin)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int h = pinbus();
+    const int counts = h >= 0 ? hwemu_adc_read(h, pin) : -1;
+    return counts > 0 ? static_cast<uint16_t>(counts) : 0;
+}
+
+void pwmWrite(const char *pin, float duty, uint32_t frequencyHz)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    const int h = pinbus();
+    if (h >= 0) hwemu_pwm_write(h, pin, duty, frequencyHz);
+}
+
+void spiTransfer(const char *bus, const uint8_t *tx, uint8_t *rx, std::size_t length)
+{
+    std::lock_guard<std::mutex> l(g_mutex);
+    std::memset(rx, 0xFF, length);
+    const int h = pinbus();
+    if (h < 0 || length == 0) return;
+    static thread_local uint8_t zeros[512];
+    const std::string target = std::string("bus:") + bus;
+    // tx may be null for a read-only transfer: clock out zeros.
+    for (std::size_t done = 0; done < length;)
+    {
+        const std::size_t n = std::min<std::size_t>(length - done, sizeof(zeros));
+        hwemu_spi_transfer(
+            h,
+            target.c_str(),
+            tx != nullptr ? tx + done : zeros,
+            rx + done,
+            static_cast<uint16_t>(n));
+        done += n;
+    }
+}
+
+uint64_t micros() { return hwemu_clock_micros(); }
+
+void loopTick()
+{
+    if (g_lockstep == -2)
+    {
+        g_lockstep = -1;
+        const char *want = std::getenv("HWEMU_LOCKSTEP");
+        if (want != nullptr && *want != '\0' && std::strcmp(want, "0") != 0)
+        {
+            if (const char *n = std::getenv("HWEMU_LOOPS_PER_TICK")) g_loopsPerTick = std::max(1, std::atoi(n));
+            const char *name = std::getenv("HWEMU_PROCESS");
+            // Waits for the hub: lockstep is what the run asked for.
+            for (int attempt = 0; attempt < 600 && g_lockstep < 0; ++attempt)
+            {
+                g_lockstep = hwemu_lockstep_join(nullptr, name != nullptr ? name : "mcb");
+                if (g_lockstep < 0) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+            if (g_lockstep < 0)
+            {
+                std::fprintf(stderr, "[hwemu] HWEMU_LOCKSTEP set, but no hub lockstep socket after 60 s\n");
+                std::exit(1);
+            }
+            g_loopsThisTick = g_loopsPerTick;  // wait for the first tick now
+        }
+    }
+    if (g_lockstep < 0) return;
+    if (++g_loopsThisTick < g_loopsPerTick) return;
+    g_loopsThisTick = 0;
+    if (g_tick != 0) hwemu_lockstep_ack(g_lockstep, g_tick);
+    uint64_t micros = 0;
+    if (hwemu_lockstep_wait(g_lockstep, &g_tick, &micros) != 0)
+    {
+        std::fprintf(stderr, "[hwemu] the hub's lockstep clock went away; stopping\n");
+        std::exit(0);
+    }
+}
+
+bool inLockstep() { return g_lockstep >= 0; }
+
+}  // namespace tap::hwemu
+
+// modm's hosted clocks are weak: on the hub's sim time, so every taproot
+// timeout and timestamp follows the sim -- and stops with it at a breakpoint.
+modm::chrono::milli_clock::time_point modm::chrono::milli_clock::now() noexcept
+{
+    return time_point{duration{static_cast<duration::rep>(hwemu_clock_micros() / 1000)}};
+}
+
+modm::chrono::micro_clock::time_point modm::chrono::micro_clock::now() noexcept
+{
+    return time_point{duration{static_cast<duration::rep>(hwemu_clock_micros())}};
+}
+
+#endif  // PLATFORM_HOSTED && HWEMU
