diff --git a/aruw-mcb-project/taproot/src/tap/board/hwemu_hal.cpp b/aruw-mcb-project/taproot/src/tap/board/hwemu_hal.cpp
new file mode 100644
index 0000000..fa541d4
--- /dev/null
+++ b/aruw-mcb-project/taproot/src/tap/board/hwemu_hal.cpp
@@ -0,0 +1,356 @@
+/*
+ * Copyright (c) 2026 Advanced Robotics at the University of Washington <robomstr@uw.edu>
+ *
+ * This file is part of Taproot.
+ *
+ * Taproot is free software: you can redistribute it and/or modify
