+#ifndef TAPROOT_HWEMU_HAL_HPP_
+#define TAPROOT_HWEMU_HAL_HPP_
+
+/*
+ * HWEMU: the hosted (simulator) build's hardware, served by hw-emulator's hub
+ * (github.com/EricJGoossen/hw-emulator) through its client library,
+ * hwemu_client.h. Only with PLATFORM_HOSTED and HWEMU (scons build-sim
+ * hwemu=<dir>); unit tests and the hardware build never see this file.
+ *
+ * This is the firmware's side of the emulator interface only. It stands in
+ * for the board's peripherals at the lowest level the drivers already use --
+ * CAN frames, UART bytes, SPI transfers, GPIO levels, PWM duty, ADC counts and
+ * the clock -- so the real drivers run unchanged against emulated chips.
+ * Everything robot-specific (models, which device is on which bus) lives in
+ * the hub's config, not here.
+ *
+ * Anything the firmware touches that the hub doesn't serve is reported once,
+ * on stderr and in the run's gap report, never ignored silently
+ * (hwemu_report_gap).
+ *
+ * Environment:
+ *   HWEMU_RUNTIME_DIR        the hub's runtime directory (default /tmp/hwemu)
+ *   HWEMU_UART_<PORT>        the hub port a UART maps to (REMOTE, USART2,
+ *                            USART3, REFSERIAL, UART7, UART8); "none" for
+ *                            unconnected. Defaults: USART2 and USART3 ->
+ *                            vision_mcb (the Jetson's one UART: the MCB sends
+ *                            on Usart2 and receives on Usart3), REFSERIAL ->
+ *                            referee, the rest unconnected.
+ *   HWEMU_LOCKSTEP           join the hub's lockstep clock (any non-empty
+ *                            value but "0")
+ *   HWEMU_LOOPS_PER_TICK     main-loop iterations per lockstep tick (default 4)
+ */
+
+#if defined(PLATFORM_HOSTED) && defined(HWEMU)
+
+#include <cstddef>
+#include <cstdint>
+
+#include "modm/architecture/interface/delay.hpp"
+#include "modm/processing/resumable.hpp"
+
+namespace tap::hwemu
+{
+// Reports a sim gap once per source/key (see hwemu_client.h).
+void gap(const char *source, const char *key, const char *message);
+
+// ---- CAN: bus 0 = CAN1 ("can1"), bus 1 = CAN2 ("can2") --------------------
+bool canSend(int bus, uint32_t id, bool extended, bool rtr, const uint8_t *data, uint8_t length);
+// Non-blocking: true with a frame.
+bool canReceive(int bus, uint32_t *id, bool *extended, bool *rtr, uint8_t *data, uint8_t *length);
+
+// ---- UART: port numbers are tap::communication::serial::Uart::UartPort ----
+void uartInit(int port);
+std::size_t uartRead(int port, uint8_t *data, std::size_t length);
+std::size_t uartWrite(int port, const uint8_t *data, std::size_t length);
+std::size_t uartDiscard(int port);
+
+// ---- pins, by their Board name ("ImuNss", "DigitalOutPinH", ...) ----------
+void gpioWrite(const char *pin, bool level);
+bool gpioRead(const char *pin);
+uint16_t adcRead(const char *pin);
+void pwmWrite(const char *pin, float duty, uint32_t frequencyHz);
+// One SPI transfer on bus `bus` ("spi4", "spi5"): routed by the hub to the
+// device whose chip select is low; a transaction spans transfers until it
+// rises. Reads back 0xFF (and reports a gap) with nothing behind it.
+void spiTransfer(const char *bus, const uint8_t *tx, uint8_t *rx, std::size_t length);
+
+// ---- clock and lockstep ---------------------------------------------------
+uint64_t micros();
+// At the top of each main-loop iteration: in lockstep, blocks for the next
+// hub tick every HWEMU_LOOPS_PER_TICK calls (and acks the last). Otherwise
+// returns at once.
+void loopTick();
+// Whether this run is in lockstep with the hub (decided by the first
+// loopTick()). Sim time then moves only between ticks, so a wall-clock delay
+// in the main loop costs time and does nothing.
+bool inLockstep();
+
+// ---- modm-shaped stand-ins for the Board's peripherals --------------------
+
+// A GPIO pin named by its Board alias, as modm's GpioX types are used.
+template <typename Self>
+struct Pin
+{
+    static void setOutput() {}
+    static void setOutput(bool level) { gpioWrite(Self::kName, level); }
+    static void set() { gpioWrite(Self::kName, true); }
+    static void set(bool level) { gpioWrite(Self::kName, level); }
+    static void reset() { gpioWrite(Self::kName, false); }
+    static bool read() { return gpioRead(Self::kName); }
+    static void GpioOutput() {}
+    template <typename... T>
+    static void setInput(T...)
+    {
+    }
+    template <typename... T>
+    static void configure(T...)
+    {
+    }
+};
+
+// An SPI master, as modm's SpiMasterN types are used. Transfers complete at
+// once, so a resumable transfer finishes on its first call.
+template <typename Self>
+struct Spi
+{
+    enum class DataMode : uint8_t
+    {
+        Mode0,
+        Mode1,
+        Mode2,
+        Mode3
+    };
+    static void setDataMode(DataMode) {}
+    template <typename... T>
+    static void connect()
+    {
+    }
+    template <typename Clock, uint32_t Baud, uint16_t Tolerance = 0>
+    static void initialize()
+    {
+    }
+    static void transferBlocking(const uint8_t *tx, uint8_t *rx, std::size_t length)
+    {
+        spiTransfer(Self::kName, tx, rx, length);
+    }
+    static uint8_t transferBlocking(uint8_t data)
+    {
+        uint8_t rx = 0;
+        spiTransfer(Self::kName, &data, &rx, 1);
+        return rx;
+    }
+    static modm::ResumableResult<void> transfer(const uint8_t *tx, uint8_t *rx, std::size_t length)
+    {
+        transferBlocking(tx, rx, length);
+        return {modm::rf::Stop};
+    }
+    static modm::ResumableResult<uint8_t> transfer(uint8_t data)
+    {
+        return {modm::rf::Stop, transferBlocking(data)};
+    }
+};
+
+}  // namespace tap::hwemu
+
+#define TAP_HWEMU_PIN(NAME)                                \
+    struct NAME : ::tap::hwemu::Pin<NAME>                  \
+    {                                                      \
+        static constexpr const char *kName = #NAME;        \
+    }
+#define TAP_HWEMU_SPI(NAME, BUS)                           \
+    struct NAME : ::tap::hwemu::Spi<NAME>                  \
+    {                                                      \
+        static constexpr const char *kName = BUS;          \
+    }
+
+// modm's GPIO output levels, which the hosted modm doesn't define.
+namespace modm
+{
+struct GpioOutput
+{
+    static constexpr bool Low = false;
+    static constexpr bool High = true;
+};
+}  // namespace modm
+
+#endif  // PLATFORM_HOSTED && HWEMU
+
+#endif  // TAPROOT_HWEMU_HAL_HPP_
