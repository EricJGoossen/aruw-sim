 env = DefaultEnvironment(ENV=os.environ)
 env["CONFIG_BUILD_BASE"] = abspath(join(BUILD_PATH, args["TARGET_ENV"]))
+
+# HWEMU: `scons build-sim hwemu=<dir>` builds the simulator against
+# hw-emulator's hub instead of the built-in motor sim. <dir> holds
+# hwemu_client.h and libhwemu_client.a (hw-emulator's client/ library).
+# Only the sim environment; it builds into build/sim-hwemu, apart from the
+# plain sim build.
+HWEMU_DIR = ARGUMENTS.get("hwemu", "")
+if HWEMU_DIR:
+    if args["TARGET_ENV"] != "sim":
+        raise Exception("hwemu=<dir> only applies to build-sim / run-sim")
+    HWEMU_DIR = abspath(HWEMU_DIR)
+    for needed in ["hwemu_client.h", "libhwemu_client.a"]:
+        if not os.path.exists(join(HWEMU_DIR, needed)):
+            raise Exception("hwemu=" + HWEMU_DIR + " has no " + needed)
+    env["CONFIG_BUILD_BASE"] = abspath(join(BUILD_PATH, "sim-hwemu"))
+    env.AppendUnique(CPPDEFINES=["HWEMU"], CPPPATH=[HWEMU_DIR])
+    env.AppendUnique(LIBPATH=[HWEMU_DIR], LIBS=["hwemu_client", "rt", "pthread"])
 env["CONFIG_PROJECT_NAME"] = PROJECT_NAME
 env["CONFIG_ARTIFACT_PATH"] = join(env["CONFIG_BUILD_BASE"], "artifact")
 env["CONFIG_PROFILE"] = args["BUILD_PROFILE"]
