+// HWEMU: CAN1 and CAN2 are the hub's buses can1 and can2 (hwemu_hal.hpp),
+// in place of the built-in motor sim. isMessageAvailable() peeks one frame
+// per bus, so it doesn't consume what getMessage() then returns.
+namespace
+{
+struct PendingFrame
+{
+    bool valid = false;
+    modm::can::Message message;
+};
+PendingFrame hwemuPending[2];
+
+bool hwemuPeek(tap::can::CanBus bus)
+{
+    const int b = static_cast<int>(bus);
+    if (b < 0 || b > 1) return false;
+    PendingFrame &p = hwemuPending[b];
+    if (p.valid) return true;
+    uint32_t id = 0;
+    bool extended = false, rtr = false;
+    uint8_t data[8] = {}, length = 0;
+    if (!tap::hwemu::canReceive(b, &id, &extended, &rtr, data, &length)) return false;
+    p.message = modm::can::Message(id, length);
+    p.message.setExtended(extended);
+    p.message.setRemoteTransmitRequest(rtr);
+    for (uint8_t i = 0; i < length && i < 8; ++i) p.message.data[i] = data[i];
+    p.valid = true;
+    return true;
+}
+}  // namespace
+#endif
