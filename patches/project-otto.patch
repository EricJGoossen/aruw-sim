         throws:
             ValueError if no connected USB port is found for the given port name
         """
+        # HWEMU: in the hw-emulator simulator there's no USB bus to search:
+        # the hub serves each LD19 on a PTY named after its configured port
+        # (<runtime dir>/ld19-<port>).
+        hwemu_runtime = os.environ.get("HWEMU_RUNTIME_DIR")
+        if hwemu_runtime:
+            path = os.path.join(hwemu_runtime, f"ld19-{port_name}")
+            if os.path.exists(path):
+                return path
+            logging.warning(f"[hwemu GAP] lidar: the hub serves no LD19 for port {port_name} ({path})")
+            return None
+
         for tty in glob.glob("/dev/ttyUSB*"):
             result = subprocess.run(["udevadm", "info", "-a", "-n", tty], capture_output=True, text=True)
             for line in result.stdout.splitlines():
